---
---
<section class="karatsuba-lab" data-karatsuba-lab aria-labelledby="karatsuba-lab-title">
  <div class="lab-heading">
    <div>
      <p class="lab-kicker">Atelier interactif</p>
      <h3 id="karatsuba-lab-title">Faites vous-même la multiplication</h3>
    </div>
    <p class="lab-intro">Modifiez les deux nombres : les trois produits, le terme croisé et la recomposition sont recalculés à chaque changement.</p>
  </div>

  <div class="lab-inputs">
    <label>Premier entier
      <input data-number="x" type="text" inputmode="numeric" value="1234" maxlength="18" autocomplete="off" aria-describedby="lab-input-help" />
    </label>
    <span class="lab-times" aria-hidden="true">×</span>
    <label>Second entier
      <input data-number="y" type="text" inputmode="numeric" value="5678" maxlength="18" autocomplete="off" aria-describedby="lab-input-help" />
    </label>
  </div>
  <p class="lab-help" id="lab-input-help">Entiers naturels de 1 à 18 chiffres (zéro compris). Les espaces sont acceptés pour la lisibilité.</p>
  <p class="lab-error" data-error role="alert" hidden></p>

  <div class="lab-result" aria-live="polite" aria-atomic="true">
    <span class="lab-result-label">Produit obtenu</span>
    <strong data-result>7 006 652</strong>
  </div>

  <div class="lab-steps" data-steps>
    <div class="lab-step"><span class="step-index">01</span><div><h4>Découper</h4><p data-split>1 234 = 12 × 100 + 34<br />5 678 = 56 × 100 + 78</p></div></div>
    <div class="lab-step"><span class="step-index">02</span><div><h4>Calculer trois produits</h4><p data-products>p = 12 × 56 = 672<br />q = 34 × 78 = 2 652<br />r = 46 × 134 = 6 164</p></div></div>
    <div class="lab-step"><span class="step-index">03</span><div><h4>Retrouver les produits croisés</h4><p data-cross>r − p − q = 2 840</p></div></div>
    <div class="lab-step"><span class="step-index">04</span><div><h4>Recomposer</h4><p data-recompose>672 × 10 000 + 2 840 × 100 + 2 652 = 7 006 652</p></div></div>
  </div>

  <div class="lab-comparison">
    <h4>Où se trouve l'économie ?</h4>
    <div class="comparison-grid">
      <div><span class="comparison-label">Découpage classique</span><strong>4</strong><span>multiplications de blocs</span><small>ac · ad · bc · bd</small></div>
      <div class="comparison-arrow" aria-hidden="true">→</div>
      <div><span class="comparison-label">Karatsuba</span><strong>3</strong><span>multiplications de blocs</span><small>ac · bd · (a+b)(c+d)</small></div>
    </div>
    <p class="lab-footnote">Cette comparaison porte sur un niveau de découpage. En répétant la méthode récursivement, on obtient la récurrence T(n) = 3T(n/2) + O(n), dans le modèle où les deux blocs sont de taille comparable.</p>
  </div>
  <noscript><p class="lab-noscript">La démonstration interactive nécessite JavaScript. L'exemple complet 1 234 × 5 678 = 7 006 652 et son calcul pas à pas sont expliqués dans le texte de l'article.</p></noscript>
</section>

<script>
  import { calculateKaratsubaStep } from "../scripts/karatsuba.js";

  const format = (value) => BigInt(value).toLocaleString("fr-FR");
  const setText = (root, selector, value) => {
    const node = root.querySelector(selector);
    if (node) node.textContent = value;
  };

  document.querySelectorAll("[data-karatsuba-lab]").forEach((root) => {
    const fields = {
      x: root.querySelector('[data-number="x"]'),
      y: root.querySelector('[data-number="y"]'),
    };
    const error = root.querySelector("[data-error]");

    const update = () => {
      const rawX = fields.x.value.replace(/[\s\u00a0]/g, "");
      const rawY = fields.y.value.replace(/[\s\u00a0]/g, "");
      const valid = (value) => /^\d{1,18}$/.test(value);
      if (!valid(rawX) || !valid(rawY)) {
        error.hidden = false;
        error.textContent = "Saisissez deux entiers naturels comportant chacun de 1 à 18 chiffres (zéro compris).";
        return;
      }

      const { a, b, c, d, base, p, q, r, cross, product: result, x, y } = calculateKaratsubaStep(rawX, rawY);
      const direct = x * y;

      error.hidden = true;
      setText(root, "[data-result]", format(result));
      setText(root, "[data-split]", `x = ${format(a)} × ${format(base)} + ${format(b)}\ny = ${format(c)} × ${format(base)} + ${format(d)}`);
      setText(root, "[data-products]", `p = ${format(a)} × ${format(c)} = ${format(p)}\nq = ${format(b)} × ${format(d)} = ${format(q)}\nr = (${format(a)} + ${format(b)}) × (${format(c)} + ${format(d)}) = ${format(r)}`);
      setText(root, "[data-cross]", `r − p − q = ${format(r)} − ${format(p)} − ${format(q)} = ${format(cross)}`);
      setText(root, "[data-recompose]", `${format(p)} × ${format(base * base)} + ${format(cross)} × ${format(base)} + ${format(q)} = ${format(result)}`);
      root.dataset.verified = String(result === direct);
    };

    fields.x.addEventListener("input", update);
    fields.y.addEventListener("input", update);
    update();
  });
</script>

<style>
  .karatsuba-lab { margin: 2.5rem 0; padding: clamp(1.1rem, 3vw, 2rem); border: 1px solid var(--line, #d9d4c8); border-radius: 1rem; background: var(--surface, #fbfaf6); color: var(--ink, #252820); }
  .lab-heading { display: flex; justify-content: space-between; align-items: start; gap: 1.5rem; }
  .lab-kicker, .lab-result-label, .comparison-label { margin: 0; color: var(--muted, #66685f); font: 500 .72rem/1.4 var(--font-mono, monospace); letter-spacing: .06em; text-transform: uppercase; }
  .lab-heading h3 { margin: .35rem 0 0; font: 600 clamp(1.35rem, 3vw, 1.8rem)/1.15 var(--font-display, Georgia, serif); }
  .lab-intro { max-width: 24rem; margin: 0; color: var(--muted, #66685f); font-size: .92rem; }
  .lab-inputs { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: end; gap: 1rem; margin-top: 1.7rem; }
  .lab-inputs label { display: grid; gap: .45rem; font-size: .82rem; font-weight: 600; }
  .lab-inputs input { width: 100%; min-width: 0; padding: .8rem .9rem; border: 1px solid var(--line, #d9d4c8); border-radius: .55rem; background: white; color: inherit; font: 500 1.15rem var(--font-mono, monospace); }
  .lab-inputs input:focus-visible { outline: 3px solid var(--accent, #a85b36); outline-offset: 2px; }
  .lab-times { padding-bottom: .8rem; color: var(--muted, #66685f); font-size: 1.2rem; }
  .lab-help, .lab-footnote, .lab-noscript { color: var(--muted, #66685f); font-size: .8rem; }
  .lab-error { color: #9c3028; font-size: .85rem; }
  .lab-result { display: grid; gap: .3rem; margin: 1.3rem 0; padding: 1rem 1.15rem; border-radius: .65rem; background: var(--ink, #252820); color: white; }
  .lab-result-label { color: #d8d8cf; }
  .lab-result strong { overflow-wrap: anywhere; font: 600 clamp(1.5rem, 4vw, 2.1rem)/1.2 var(--font-mono, monospace); }
  .lab-steps { display: grid; gap: 0; border-top: 1px solid var(--line, #d9d4c8); }
  .lab-step { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: .8rem; padding: 1rem 0; border-bottom: 1px solid var(--line, #d9d4c8); }
  .step-index { color: var(--accent, #a85b36); font: 500 .8rem var(--font-mono, monospace); }
  .lab-step h4, .lab-comparison h4 { margin: 0 0 .35rem; font-size: .95rem; }
  .lab-step p { margin: 0; white-space: pre-line; overflow-wrap: anywhere; font: .83rem/1.7 var(--font-mono, monospace); }
  .lab-comparison { margin-top: 1.4rem; }
  .comparison-grid { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: .8rem; margin: 1rem 0; }
  .comparison-grid > div:not(.comparison-arrow) { display: grid; gap: .25rem; padding: .9rem; border: 1px solid var(--line, #d9d4c8); border-radius: .6rem; }
  .comparison-grid strong { font: 600 2rem var(--font-mono, monospace); }
  .comparison-grid span:not(.comparison-label) { font-size: .8rem; }
  .comparison-grid small { color: var(--muted, #66685f); font: .7rem var(--font-mono, monospace); }
  .comparison-arrow { color: var(--accent, #a85b36); }
  .lab-footnote { margin-bottom: 0; line-height: 1.6; }
  @media (max-width: 620px) { .lab-heading { display: block; } .lab-intro { margin-top: .8rem; } .lab-inputs { gap: .5rem; } .comparison-grid { gap: .35rem; } .comparison-grid > div:not(.comparison-arrow) { padding: .65rem; } }
  @media (prefers-reduced-motion: reduce) { .karatsuba-lab * { scroll-behavior: auto !important; } }
</style>
