  .tree-node text { fill:var(--term-common,#286d61); text-anchor:middle; dominant-baseline:middle; font:600 14px "DM Mono",monospace; }
  .tree-node.root-node rect { fill:var(--term-common,#286d61); stroke:var(--term-common,#286d61); }
