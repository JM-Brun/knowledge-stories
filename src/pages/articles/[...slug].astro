---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import KaratsubaExplorer from "../../components/KaratsubaExplorer.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => data.status === "published");
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}
const { article } = Astro.props;
const { Content } = await render(article);
---
<BaseLayout title={`${article.data.title} — Knowledge Stories`} description={article.data.description}>
  <main class="article-page">
    <header class="article-header">
      <a class="back-link" href="/knowledge-stories/">← Tous les articles</a>
      <p class="eyebrow">{article.data.category}</p>
      <h1>{article.data.title}</h1>
      <p class="article-deck">{article.data.description}</p>
      <div class="article-meta"><span>{article.data.date.toLocaleDateString("fr-FR", { dateStyle: "long" })}</span><span>{article.data.difficulty === "introductory" ? "Introduction" : article.data.difficulty === "intermediate" ? "Intermédiaire" : "Avancé"}</span>{article.data.readingTime && <span>{article.data.readingTime} min de lecture</span>}</div>
    </header>
    <article class="prose"><Content /></article>
    {article.id === "karatsuba-multiplication" && <KaratsubaExplorer />}
    {article.data.sources.length > 0 && <section class="sources"><h2>Pour aller plus loin</h2><ol>{article.data.sources.map((source) => <li><a href={source.url} rel="noreferrer">{source.title}</a> <span>({source.kind})</span></li>)}</ol></section>}
  </main>
</BaseLayout>
