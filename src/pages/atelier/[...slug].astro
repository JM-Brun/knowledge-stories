---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { seriesInfo } from "../../data/series";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => data.status === "review");
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const sections = headings.filter(({ depth }) => depth === 2);
const date = new Intl.DateTimeFormat("fr-FR", { dateStyle: "long", timeZone: "UTC" });
const difficulty = { introductory: "Introduction", intermediate: "Intermédiaire", advanced: "Avancé" };
const baseUrl = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const readingTimeFor = (entry: { data: { readingTime?: number }; body: string }) => entry.data.readingTime ?? Math.max(1, Math.ceil(entry.body.replace(/```[\s\S]*?```/g, " ").replace(/<[^>]+>/g, " ").split(/\s+/).filter(Boolean).length / 180));
const seriesArticles = article.data.series
  ? (await getCollection("articles", ({ data }) => data.status === "review" && data.series === article.data.series))
      .sort((a, b) => (a.data.seriesOrder ?? 999) - (b.data.seriesOrder ?? 999))
  : [];
const seriesTotalReadingTime = seriesArticles.reduce((total, item) => total + readingTimeFor(item), 0);
---
<BaseLayout title={`Relecture — ${article.data.title} — Knowledge Stories`} description={article.data.description} noindex>
  <main class="review-page">
    <div class="review-banner">
      <strong>Version de travail · Relecture</strong>
      <span>Ce texte n'est pas une publication validée. Merci de signaler les erreurs, ambiguïtés et pistes d'amélioration.</span>
    </div>
    <header class="story-header">
      <div class="review-actions"><a class="back-link" href={`${baseUrl}atelier/`}>← Index de relecture</a><a class="edit-link" href={`https://github.com/JM-Brun/knowledge-stories/edit/main/src/content/articles/${article.id}`} target="_blank" rel="noreferrer">Éditer la source sur GitHub ↗</a></div>
      <p class="category">{article.data.discipline} · {article.data.themes[0]}</p>
      {article.data.labels.length > 0 && <div class="article-labels" aria-label="Concepts principaux">{article.data.labels.map((label) => <span class="article-label">{label}</span>)}</div>}
      <h1>{article.data.title}</h1>
      <p class="deck">{article.data.description}</p>
      <div class="meta"><time datetime={article.data.date.toISOString().slice(0, 10)}>{date.format(article.data.date)}</time><span>{difficulty[article.data.difficulty]}</span><span>{readingTimeFor(article)} min de lecture</span></div>
    </header>
    {seriesArticles.length > 1 && article.data.series && (
      <nav class="review-series" aria-label={`Série ${seriesInfo[article.data.series].title}`}>
        <div class="review-series-heading">
          <div>
            <p class="series-kicker">Parcours de lecture</p>
            <h2>{seriesTitles[article.data.series]}</h2>
          </div>
          <span>{seriesArticles.length} articles · {seriesTotalReadingTime} min au total</span>
        </div>
        <ol>
          {seriesArticles.map((item) => (
            <li class:list={[{ current: item.id === article.id }]}>
              {item.id === article.id
                ? <span aria-current="page"><small>{item.data.seriesOrder === 0 ? "Introduction" : `Étape ${item.data.seriesOrder}`} · {readingTimeFor(item)} min</small>{item.data.title}</span>
                : <a href={`${baseUrl}atelier/${item.slug}/`}><small>{item.data.seriesOrder === 0 ? "Introduction" : `Étape ${item.data.seriesOrder}`} · {readingTimeFor(item)} min</small>{item.data.title}</a>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    <div class="review-layout">
      {sections.length > 0 && <nav class="outline" aria-label="Sommaire de la version de travail"><strong>Dans cet article</strong><ul>{sections.map(({ slug, text }) => <li><a href={`#${slug}`}>{text}</a></li>)}</ul></nav>}
      <article class="prose"><Content />
        {article.data.sources.length > 0 && <section class="sources"><h2>Sources déclarées</h2><ol>{article.data.sources.map((source) => <li><a href={source.url} rel="noreferrer">{source.title}</a> <span>({source.kind}{source.accessed ? ` · consulté le ${date.format(source.accessed)}` : ""})</span></li>)}</ol></section>}
      </article>
    </div>
  </main>
</BaseLayout>

<style>
  .review-page { max-width: 75rem; margin: 0 auto; padding: 2rem clamp(1rem, 4vw, 3rem) 6rem; }
  .review-banner { display: grid; gap: .35rem; padding: .9rem 1rem; border: 1px solid #d7b98a; border-left: 4px solid #9a6630; border-radius: .35rem; background: #faf3e6; color: #493b2c; font: .85rem/1.5 "DM Sans", sans-serif; }
  .review-banner strong { font-size: .9rem; }
  .story-header { max-width: 64rem; padding: clamp(2.5rem, 6vw, 5rem) 0 2.5rem; border-bottom: 1px solid var(--line); }
  .story-header h1 { max-width: 20ch; }
  .review-page { max-width: 82rem; }
  .review-banner { max-width: 64rem; margin: 0 auto; }
  .prose :global(.source-provenance) { margin: 0 0 2.5rem; padding: 1.2rem 1.35rem; border: 1px solid #c9d4c7; border-left: 5px solid #315b45; border-radius: .55rem; background: #edf2e9; color: #263b2e; font: .94rem/1.65 "DM Sans", sans-serif; }
  .prose :global(.source-provenance strong) { display: block; margin-bottom: .35rem; color: #244b37; font-size: .78rem; letter-spacing: .07em; text-transform: uppercase; }
  .prose :global(.source-provenance a) { color: #244b37; font-weight: 700; text-underline-offset: 3px; }
  .prose :global(.comparison-figure) { margin: 2.5rem 0; }
  /* Karatsuba summary cards are styled centrally in global.css; do not redefine .math-lead here. */
  .review-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1.25rem; margin-bottom: 1.8rem; }
  .back-link { display: inline-block; color: #625b4d; }
  .edit-link { display: inline-block; padding: .45rem .7rem; border: 1px solid var(--line); border-radius: .35rem; color: #843c27; font: 600 .78rem/1.4 "DM Sans", sans-serif; text-decoration: none; }
  .edit-link:hover { background: #faf7ef; border-color: #843c27; }
  .edit-link:focus-visible { outline: 2px solid #843c27; outline-offset: 3px; }
  .category { color: #843c27; font: 500 .75rem/1.4 "DM Mono", monospace; letter-spacing: .07em; text-transform: uppercase; }
  .article-labels { display: flex; flex-wrap: wrap; gap: .4rem; margin: .75rem 0; }
  .article-label { padding: .22rem .55rem; border: 1px solid #d8cbbb; border-radius: 99px; color: #75432f; background: #f7f1e8; font: 500 .68rem/1.4 "DM Sans", sans-serif; }
  h1 { max-width: 18ch; margin: .5rem 0; color: var(--ink); font: 500 clamp(2.5rem, 5.5vw, 5rem)/1 "Newsreader", serif; letter-spacing: -.04em; }
  .deck { max-width: 43ch; color: #514d42; font: 1.3rem/1.5 "Newsreader", serif; }
  .meta { display: flex; flex-wrap: wrap; gap: .4rem 1rem; color: #625b4d; font: .75rem/1.4 "DM Mono", monospace; }
  .review-series { max-width: 64rem; margin: 1.5rem auto 0; padding: 1.1rem 1.2rem; border: 1px solid var(--line); border-radius: .6rem; background: #faf7ef; }
  .review-series-heading { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: .5rem 1rem; }
  .review-series-heading .series-kicker { margin: 0 0 .35rem; color: #843c27; font: 500 .68rem/1.4 "DM Mono", monospace; letter-spacing: .08em; text-transform: uppercase; }
  .review-series-heading h2 { margin: 0; color: var(--ink); font: 500 clamp(1.25rem, 3vw, 1.7rem)/1.15 "Newsreader", serif; }
  .review-series-heading > span { color: #817968; font: .68rem/1.4 "DM Mono", monospace; }
  .review-series ol { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: .55rem; margin: 1rem 0 0; padding: 0; list-style: none; }
  .review-series li { min-width: 0; }
  .review-series a, .review-series li > span { display: flex; height: 100%; flex-direction: column; gap: .3rem; padding: .7rem .8rem; border: 1px solid #e1dacb; border-radius: .4rem; color: #514d42; background: #fffdf8; font: 500 .83rem/1.4 "DM Sans", sans-serif; text-decoration: none; }
  .review-series a:hover { border-color: #843c27; color: #843c27; }
  .review-series li.current > span { border-color: #843c27; background: #f2eadc; color: #352d25; font-weight: 700; }
  .review-series small { color: #843c27; font: 500 .65rem/1.4 "DM Mono", monospace; letter-spacing: .04em; text-transform: uppercase; }
  .review-series a:focus-visible { outline: 2px solid #843c27; outline-offset: 3px; }
  .review-layout { display: grid; max-width: 67rem; margin: 0 auto; }
  .prose { max-width: 44rem; margin: 2.5rem auto 0; color: #34352f; line-height: 1.75; }
  .prose :global(h2) { margin-top: 2.8rem; scroll-margin-top: 1.5rem; font: 500 clamp(1.8rem, 4vw, 2.4rem)/1.15 "Newsreader", serif; }
  .prose :global(a), .sources a, .outline a { color: #843c27; }
  .sources li span { color: #625b4d; }
  .outline { margin: 1.5rem 0 0; padding: 1rem 0; border-block: 1px solid var(--line); }
  .outline ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .35rem 1rem; padding-left: 1.1rem; }
  .prose :global(.math-display) {
    display: grid;
    justify-items: center;
    gap: .38rem;
    margin: 1.5rem 0 1.8rem;
    padding: 1.15rem clamp(.8rem, 3vw, 1.5rem);
    overflow-x: auto;
    border: 1px solid #e1dacb;
    border-radius: .65rem;
    background: linear-gradient(135deg, #fbf8f0, #f0ecdf);
    color: #252820;
    font: 500 clamp(1.05rem, 2.4vw, 1.42rem)/1.55 "Newsreader", Georgia, serif;
    font-variant-numeric: lining-nums tabular-nums;
    text-align: center;
  }
  .prose :global(.math-line) { white-space: nowrap; }
  .prose :global(.math-line i) { font-style: italic; }
  .prose :global(.math-line sup) { font-size: .68em; vertical-align: .55em; }
  .prose :global(.math-line strong) { color: #315d47; font-weight: 700; }
  .prose :global(.math-display--compact) { gap: .12rem; padding-block: .85rem; }
  .prose :global(.math-display--key) { border-color: #c8d6c9; background: linear-gradient(135deg, #f2f6ef, #e8efe5); }
  .prose :global(.math-caption) { color: #586357; font: 500 .72rem/1.5 "DM Sans", sans-serif; white-space: normal; text-align: center; }
  .prose :global(.math-display--worked) { align-items: start; justify-items: start; }
  .prose :global(.math-result) { margin-top: .25rem; padding-top: .35rem; border-top: 1px solid #c8d6c9; color: #315d47; font-size: 1.25em; font-weight: 700; }
  .prose :global(.calculation-bridge) { margin: 1.8rem 0; padding: 1rem 1.2rem; border-left: 3px solid #52745c; background: #f0eee5; }
  .prose :global(.calculation-bridge p) { margin: .2rem 0 .7rem; font: 500 .88rem/1.65 "DM Sans", sans-serif; color: #4d554b; }
  .prose :global(.calculation-bridge .calculation-bridge-title) { color: #315d47; font-weight: 700; text-transform: uppercase; letter-spacing: .045em; font-size: .72rem; }
  .prose :global(.calculation-bridge .math-display) { margin-block: .8rem; }
  @media (max-width: 38rem) {
    .prose :global(.math-display) { justify-items: start; font-size: 1rem; }
    .prose :global(.math-display--worked) { font-size: .9rem; }
    .prose :global(.math-caption) { text-align: left; }
  }

  @media (min-width: 62rem) {
    .review-layout { grid-template-columns: minmax(0, 1fr) 14rem; gap: 3rem; }
    .prose { grid-column: 1; grid-row: 1; width: 100%; }
    .outline { grid-column: 2; grid-row: 1; position: sticky; top: 1.5rem; align-self: start; margin-top: 3rem; border: 0; border-inline-start: 1px solid var(--line); padding: .25rem 0 .25rem 1rem; }
    .outline ul { grid-template-columns: 1fr; }
  }
</style>
