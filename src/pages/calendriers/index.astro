---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { calendarStories } from "../../data/archive";
const articles = await getCollection("articles", ({ data }) => data.status === "published");
const articleItems = articles.map((article) => ({
  title: article.data.title,
  description: article.data.description,
  href: `${import.meta.env.BASE_URL}articles/${article.id}/`,
  themes: article.data.themes.length ? article.data.themes : [article.data.category],
  tags: article.data.tags,
  year: article.data.date.getUTCFullYear(),
  source: "Article",
}));
const thematicItems = [
  ...calendarStories.map((story) => ({
    ...story,
    href: `${import.meta.env.BASE_URL}${story.href}`,
    source: `Calendrier ${story.year} · jour ${String(story.day).padStart(2, "0")}`,
  })),
  ...articleItems,
];
const themes = [...new Set(thematicItems.flatMap((item) => item.themes))].sort((a, b) => a.localeCompare(b, "fr"));
const storiesByTheme = themes.map((theme) => ({
  name: theme,
  items: thematicItems.filter((item) => item.themes.includes(theme)).sort((a, b) => a.title.localeCompare(b.title, "fr")),
}));
const years = [...new Set(calendarStories.map((story) => story.year))].sort((a, b) => b - a);
---
<BaseLayout title="Les archives | Knowledge Stories" description="Retrouver les éditions annuelles et explorer les histoires par thème.">
  <main class="archive-page">
    <header class="archive-hero">
      <p class="eyebrow">Le catalogue des histoires</p>
      <h1>Une idée,<br /><em>plusieurs chemins.</em></h1>
      <p class="archive-lead">Parcourez les éditions dans leur ordre de publication, ou entrez directement par les thèmes et les concepts. Une même histoire peut apparaître dans plusieurs regroupements : les liens restent uniques, seule la perspective change.</p>
    </header>

    <nav class="archive-switch" aria-label="Modes de consultation">
      <a href="#editions">Par calendrier <span aria-hidden="true">↓</span></a>
      <a href="#themes">Par thématique <span aria-hidden="true">↓</span></a>
    </nav>

    <section class="archive-section" id="editions" aria-labelledby="editions-title">
      <div class="section-heading"><p class="eyebrow">Chronologie éditoriale</p><h2 id="editions-title">Les calendriers</h2></div>
      {years.map((year) => {
        const items = calendarStories.filter((story) => story.year === year).sort((a, b) => a.day - b.day);
        return <article class="archive-edition">
          <div class="archive-year"><span>{year}</span><small>{items.length} histoires publiées</small></div>
          <div class="archive-edition-content">
            <p class="archive-edition-kicker">{items[0]?.calendar}</p>
            <h3>{items[0]?.calendar}</h3>
            <p class="archive-edition-description">Une progression facultative en 24 questions. Chaque histoire peut aussi se lire indépendamment.</p>
            <a class="archive-primary-link" href={`${import.meta.env.BASE_URL}calendar/`}>Ouvrir l'édition {year} <span aria-hidden="true">↗</span></a>
            <ol class="archive-day-list">
              {items.map((item) => <li><a href={`${import.meta.env.BASE_URL}${item.href}`}><span class="archive-day-number">{String(item.day).padStart(2, "0")}</span><span>{item.title}</span><span aria-hidden="true">↗</span></a></li>)}
            </ol>
          </div>
        </article>;
      })}
      <p class="archive-note">Chaque édition annuelle possède sa propre page, son calendrier et son fil conducteur. Les archives permettent de retrouver les éditions précédentes sans imposer de parcours entre les années.</p>
    </section>

    <section class="archive-section archive-themes" id="themes" aria-labelledby="themes-title">
      <div class="section-heading"><p class="eyebrow">Index transversal</p><h2 id="themes-title">Explorer par thématique</h2></div>
      <p class="archive-section-intro">Ces regroupements sont construits à partir des thèmes associés à chaque histoire. Une page peut appartenir à plusieurs thèmes : c'est volontaire, car les concepts se recoupent.</p>
      <div class="theme-index">
        {storiesByTheme.map((group, index) => <section class="theme-group" aria-labelledby={`theme-${index}`}>
          <div class="theme-heading"><h3 id={`theme-${index}`}>{group.name}</h3><span>{group.items.length} {group.items.length > 1 ? "histoires" : "histoire"}</span></div>
          <ul>
            {group.items.map((item) => <li><a href={item.href}><span class="theme-item-title">{item.title}</span><span class="theme-item-meta">{item.source}</span><span class="theme-item-arrow" aria-hidden="true">↗</span></a></li>)}
          </ul>
        </section>)}
      </div>
      {thematicItems.length === 0 && <p class="archive-empty">Les premières histoires seront indexées ici après publication.</p>}
    </section>
  </main>
</BaseLayout>

<style>
  .archive-switch{display:flex;gap:.75rem;flex-wrap:wrap;padding:1.1rem 0;border-bottom:1px solid var(--line)}
  .archive-switch a{display:inline-flex;gap:.8rem;align-items:center;padding:.7rem 1rem;border:1px solid var(--line);border-radius:99px;color:var(--ink);font:600 .78rem "DM Sans",sans-serif;text-decoration:none}
  .archive-switch a:hover{border-color:var(--accent);color:var(--accent)}
  .archive-edition{display:grid;grid-template-columns:minmax(130px,.38fr) 1fr;gap:clamp(1.5rem,5vw,4rem);padding:2rem 0;border-top:1px solid var(--line)}
  .archive-year{display:grid;align-content:start;gap:.45rem}
  .archive-year>span{font:500 clamp(2.5rem,5vw,4rem)/1 var(--serif);letter-spacing:-.05em}
  .archive-year small,.archive-edition-kicker,.archive-day-number,.theme-item-meta{font: .68rem var(--mono);letter-spacing:.04em;color:var(--muted)}
  .archive-edition-kicker{margin:0 0 .7rem;text-transform:uppercase;letter-spacing:.1em;color:var(--accent)}
  .archive-edition-content h3{margin:0;font:500 clamp(1.7rem,3vw,2.4rem)/1.1 var(--serif);letter-spacing:-.03em}
  .archive-edition-description,.archive-section-intro{max-width:650px;color:var(--muted);font-size:.9rem;line-height:1.7}
  .archive-primary-link{display:inline-flex;gap:.8rem;margin:1rem 0 1.4rem;color:var(--accent);font-size:.8rem;font-weight:700;text-decoration:none}
  .archive-day-list,.theme-group ul{margin:0;padding:0;list-style:none;border-top:1px solid var(--line)}
  .archive-day-list li,.theme-group li{border-bottom:1px solid var(--line)}
  .archive-day-list a{display:grid;grid-template-columns:2.5rem 1fr 1rem;gap:.8rem;align-items:center;padding:.75rem 0;color:var(--ink);font-size:.85rem;text-decoration:none}
  .archive-day-list a:hover,.theme-group a:hover .theme-item-title{color:var(--accent)}
  .archive-day-number{color:var(--accent)}
  .archive-note{max-width:700px;margin:2rem 0 0;color:var(--muted);font-size:.8rem;line-height:1.7}
  .archive-themes{border-top:1px solid var(--line)}
  .theme-index{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:2.5rem 3rem;margin-top:2rem}
  .theme-group{min-width:0}
  .theme-heading{display:flex;justify-content:space-between;align-items:baseline;gap:1rem;margin-bottom:.9rem}
  .theme-heading h3{margin:0;font:500 1.5rem/1.1 var(--serif)}
  .theme-heading>span{flex:none;color:var(--muted);font:.65rem var(--mono)}
  .theme-group a{display:grid;grid-template-columns:1fr auto;gap:.25rem .75rem;padding:.85rem 0;color:var(--ink);text-decoration:none}
  .theme-item-title{font:500 1rem/1.3 var(--serif)}
  .theme-item-meta{grid-column:1;color:var(--muted)}
  .theme-item-arrow{grid-column:2;grid-row:1/3;color:var(--accent)}
  .archive-empty{padding:1.5rem;background:#eae6dc;color:var(--muted)}
  @media(max-width:700px){.archive-edition{grid-template-columns:1fr;gap:1rem}.archive-year{display:flex;align-items:baseline;gap:1rem}.theme-index{grid-template-columns:1fr;gap:2rem}.archive-day-list a{font-size:.8rem}}
</style>
